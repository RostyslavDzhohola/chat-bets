PORT=3000
TWITCH_CHANNEL=your_channel
TWITCH_BOT_USERNAME=your_bot_account
TWITCH_BOT_TOKEN=oauth:your_bot_oauth_token
# Optional EventSub custom reward redemption. Use the broadcaster's user token
# with channel:read:redemptions (or channel:manage:redemptions).
TWITCH_CLIENT_ID=your_app_client_id
TWITCH_EVENTSUB_TOKEN=your_broadcaster_user_token
# Optional: match by reward ID instead of the exact title "Double down".
TWITCH_DOUBLE_DOWN_REWARD_ID=your_custom_reward_id
# Client secret is not needed by the running app. It may be needed when obtaining
# the broadcaster token through an OAuth authorization-code flow.
TWITCH_CLIENT_SECRET=your_app_client_secret
# Optional: set to the streamer's login if it differs from TWITCH_CHANNEL.
TWITCH_STREAMER_USERNAME=your_channel
DATA_FILE=./data/state.json
